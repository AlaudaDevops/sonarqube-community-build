# Copy to .env and fill in. .env is git-ignored.
#
# Used by ./hack/sync-trivyignore.sh and other vuln-fix tooling.

# Thanos (CVE exemption tracking) API host. Default if unset:
# THANOS_API_HOST=thanos.alaudatech.net

# Thanos plugin name for this repo. Confirm with the platform team — the API
# returns {"data":[]} for any plugin name, so a wrong value silently produces
# an empty .trivyignore.
# THANOS_PLUGIN=sonarqube-ce-operator

# Thanos branch identifier. Defaults to the current git branch.
# THANOS_BRANCH=alauda-2026.1.0

# Container registry mirror in case build-harbor.alauda.cn is unreachable.
# HARBOR_REGISTRY_HOST=registry.alauda.cn:60070
