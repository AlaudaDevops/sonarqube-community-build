FROM docker.io/library/eclipse-temurin:21-jdk-noble AS builder

ENV LANG='en_US.UTF-8' \
    LANGUAGE='en_US:en' \
    LC_ALL='en_US.UTF-8'

#
# SonarQube setup
#
ARG SONARQUBE_VERSION=26.1.0.118079
ENV DOCKER_RUNNING="true" \
    JAVA_HOME='/opt/java/openjdk' \
    SONARQUBE_HOME=/opt/sonarqube \
    SONAR_VERSION="${SONARQUBE_VERSION}" \
    SQ_DATA_DIR="/opt/sonarqube/data" \
    SQ_EXTENSIONS_DIR="/opt/sonarqube/extensions" \
    SQ_LOGS_DIR="/opt/sonarqube/logs" \
    SQ_TEMP_DIR="/opt/sonarqube/temp"

# Separate stage to use variable expansion
ENV ES_TMPDIR="${SQ_TEMP_DIR}"

# migration(sonarqube): apt version pins removed. The exact patch versions the upstream
# pinned (curl=8.5.0-2ubuntu10.9, openssl=3.0.13-0ubuntu3.11, ...) only exist on the
# frozen hub-mirrors.alauda.cn snapshot; on docker.io's live noble archive (this base is
# now docker.io, hub-mirrors being unreachable from edge-build) those patch versions have
# rolled forward and been GC'd -> "Version ... not found". Ubuntu security updates are
# monotonic, so the current versions are >= the pins and retain the same CVE fixes.
RUN set -eux; \
    deluser ubuntu; \
    useradd --system --uid 1000 --gid 0 sonarqube; \
    apt-get update; \
    apt-get --no-install-recommends -y install \
        bash \
        fonts-dejavu \
        gnupg \
        unzip \
        curl \
        dpkg \
        libcurl4t64 \
        libgcrypt20 \
        liblzma5 \
        libnghttp2-14 \
        openssl \
        libssl3t64 \
        libfreetype6 \
        libgnutls30t64 \
        libpng16-16t64 \
        libssh-4 \
        libsystemd0 \
        libudev1 \
        libcap2 \
        sed;

COPY --chown=sonarsource:sonarsource source/sonar-application/build/distributions/sonar-application-${SONARQUBE_VERSION}.zip /home/sonarsource/
COPY --chown=sonarsource:sonarsource --chmod=555 image/community-build/jar-tools.sh /tmp/jar-tools.sh

RUN set -eux; \
    echo "networkaddress.cache.ttl=5" >> "${JAVA_HOME}/conf/security/java.security"; \
    sed --in-place --expression="s?securerandom.source=file:/dev/random?securerandom.source=file:/dev/urandom?g" "${JAVA_HOME}/conf/security/java.security"; \
    # pub   2048R/D26468DE 2015-05-25
    #       Key fingerprint = F118 2E81 C792 9289 21DB  CAB4 CFCA 4A29 D264 68DE
    # uid                  sonarsource_deployer (Sonarsource Deployer) <infra@sonarsource.com>
    # sub   2048R/06855C1D 2015-05-25
    unzip -q /home/sonarsource/sonar-application-${SONARQUBE_VERSION}.zip; \
    mv "sonarqube-${SONARQUBE_VERSION}" /opt/sonarqube; \
    rm /home/sonarsource/sonar-application-${SONARQUBE_VERSION}.zip*; \
    rm -rf ${SONARQUBE_HOME}/bin/*; \
    ln -s "${SONARQUBE_HOME}/lib/sonar-application-${SONARQUBE_VERSION}.jar" "${SONARQUBE_HOME}/lib/sonarqube.jar"; \
    chown -R sonarqube:root ${SONARQUBE_HOME}; \
    chown -R sonarqube:root "${SQ_DATA_DIR}" "${SQ_EXTENSIONS_DIR}" "${SQ_LOGS_DIR}" "${SQ_TEMP_DIR}"; \
    chmod -R 550 ${SONARQUBE_HOME}; \
    chmod -R 770 "${SQ_DATA_DIR}" "${SQ_EXTENSIONS_DIR}" "${SQ_LOGS_DIR}" "${SQ_TEMP_DIR}"; \
    apt-get remove -y gnupg unzip; \
    rm -rf /var/lib/apt/lists/*;

# ES 8.19.16 ships netty 4.1.133.Final; several artifacts still need 4.1.135.Final.
# renovate: datasource=maven depName=netty-handler lookupName=io.netty:netty-handler
ARG NETTY_VERSION=4.1.135.Final
RUN set -eux; \
    for d in ${SONARQUBE_HOME}/elasticsearch/modules/transport-netty4 \
             ${SONARQUBE_HOME}/elasticsearch/modules/x-pack-inference \
             ${SONARQUBE_HOME}/elasticsearch/modules/x-pack-security; do \
        /tmp/jar-tools.sh replace "io.netty" "netty-handler"   4.1.133.Final "$NETTY_VERSION" "$d"; \
        /tmp/jar-tools.sh replace "io.netty" "netty-codec-http" 4.1.133.Final "$NETTY_VERSION" "$d"; \
    done; \
    /tmp/jar-tools.sh replace "io.netty" "netty-codec-http2"  4.1.133.Final "$NETTY_VERSION" "${SONARQUBE_HOME}/elasticsearch/modules/x-pack-inference"; \
    /tmp/jar-tools.sh replace "io.netty" "netty-resolver-dns" 4.1.133.Final "$NETTY_VERSION" "${SONARQUBE_HOME}/elasticsearch/modules/x-pack-inference"

# renovate: datasource=maven depName=commons-lang3 lookupName=org.apache.commons:commons-lang3
ARG COMMONS_LANG3_VERSION=3.18.0
# renovate: datasource=maven depName=jakarta.mail lookupName=com.sun.mail:jakarta.mail
ARG JAKARTA_MAIL_VERSION=1.6.8
RUN set -eux; \
    /tmp/jar-tools.sh replace "org.apache.commons" "commons-lang3" 3.9 "$COMMONS_LANG3_VERSION" "${SONARQUBE_HOME}/elasticsearch/modules/x-pack-inference/"; \
    /tmp/jar-tools.sh replace "com.sun.mail" "jakarta.mail" 1.6.3 "$JAKARTA_MAIL_VERSION" "${SONARQUBE_HOME}/elasticsearch/modules/x-pack-security"

# renovate: datasource=maven depName=jackson-core lookupName=com.fasterxml.jackson.core:jackson-core
ARG JACKSON_CORE_FIXED_VERSION=2.21.2
RUN set -eux; \
    /tmp/jar-tools.sh replace "com.fasterxml.jackson.core" "jackson-core" 2.15.0 "$JACKSON_CORE_FIXED_VERSION" "${SONARQUBE_HOME}/elasticsearch/modules/x-pack-inference/"; \
    /tmp/jar-tools.sh overlay-from-maven "com.fasterxml.jackson.core" "jackson-core" "$JACKSON_CORE_FIXED_VERSION" "${SONARQUBE_HOME}/elasticsearch/bin/elasticsearch-sql-cli-8.19.16.jar"; \
    /tmp/jar-tools.sh overlay-from-maven "com.fasterxml.jackson.core" "jackson-core" "$JACKSON_CORE_FIXED_VERSION" "${SONARQUBE_HOME}/elasticsearch/lib/elasticsearch-x-content-8.19.16.jar" "IMPL-JARS/x-content/jackson-core-2.17.2.jar"; \
    /tmp/jar-tools.sh overlay-from-maven "com.fasterxml.jackson.core" "jackson-core" "$JACKSON_CORE_FIXED_VERSION" "${SONARQUBE_HOME}/elasticsearch/lib/tools/plugin-cli/elasticsearch-x-content-8.19.16.jar" "IMPL-JARS/x-content/jackson-core-2.17.2.jar"; \
    /tmp/jar-tools.sh overlay-from-maven "com.fasterxml.jackson.core" "jackson-core" "$JACKSON_CORE_FIXED_VERSION" "${SONARQUBE_HOME}/lib/sonar-application-${SONARQUBE_VERSION}.jar"; \
    /tmp/jar-tools.sh overlay-from-maven "com.fasterxml.jackson.core" "jackson-core" "$JACKSON_CORE_FIXED_VERSION" "${SONARQUBE_HOME}/lib/extensions/sonar-python-plugin-5.19.0.32098.jar"

COPY --chown=root:root --chmod=555 image/community-build/entrypoint.sh ${SONARQUBE_HOME}/docker/

# CVE-2025-13465: patch lodash baseUnset to prevent prototype pollution via _.unset / _.omit
COPY --chown=root:root --chmod=555 image/community-build/patch-lodash-cve-2025-13465.py /tmp/patch-lodash-cve-2025-13465.py
RUN apt-get update && apt-get install -y --no-install-recommends python3-minimal && \
    python3 /tmp/patch-lodash-cve-2025-13465.py && \
    apt-get remove -y python3-minimal && \
    rm -rf /var/lib/apt/lists/*

# remove sniff tools
RUN set +e; \
  ls -d /usr/bin/* | grep -E "cpp|readelf|gcc|nc|netcat" | xargs rm; \
  rm /usr/lib/apt/methods/mirror

FROM docker.io/library/eclipse-temurin:21-jdk-noble

COPY --from=builder / /

LABEL io.k8s.description="SonarQube Community Build is a self-managed, automatic code review tool that systematically helps you deliver Clean Code."
LABEL io.openshift.min-cpu=400m
LABEL io.openshift.min-memory=2048M
LABEL io.openshift.non-scalable=true
LABEL io.openshift.tags=sonarqube,static-code-analysis,code-quality,clean-code
LABEL org.opencontainers.image.url=https://github.com/SonarSource/docker-sonarqube

ENV LANG='en_US.UTF-8' \
    LANGUAGE='en_US:en' \
    LC_ALL='en_US.UTF-8'

#
# SonarQube setup
#
ARG SONARQUBE_VERSION=26.1.0.118079
ENV DOCKER_RUNNING="true" \
    JAVA_HOME='/opt/java/openjdk' \
    SONARQUBE_HOME=/opt/sonarqube \
    SONAR_VERSION="${SONARQUBE_VERSION}" \
    SQ_DATA_DIR="/opt/sonarqube/data" \
    SQ_EXTENSIONS_DIR="/opt/sonarqube/extensions" \
    SQ_LOGS_DIR="/opt/sonarqube/logs" \
    SQ_TEMP_DIR="/opt/sonarqube/temp"

# Separate stage to use variable expansion
ENV ES_TMPDIR="${SQ_TEMP_DIR}"

VOLUME ["${SQ_DATA_DIR}", "${SQ_EXTENSIONS_DIR}", "${SQ_LOGS_DIR}", "${SQ_TEMP_DIR}"]

WORKDIR ${SONARQUBE_HOME}
EXPOSE 9000

USER sonarqube
STOPSIGNAL SIGINT

ENTRYPOINT ["/opt/sonarqube/docker/entrypoint.sh"]
