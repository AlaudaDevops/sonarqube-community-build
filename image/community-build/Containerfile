FROM registry-cache.alauda.io/library/eclipse-temurin:21-jdk-noble AS builder

ENV LANG='en_US.UTF-8' \
    LANGUAGE='en_US:en' \
    LC_ALL='en_US.UTF-8'

#
# SonarQube setup
#
ARG SONARQUBE_VERSION=26.1.0.118079
ENV DOCKER_RUNNING="true" \
    JAVA_HOME='/opt/java/openjdk' \
    SONARQUBE_HOME=/opt/sonarqube \
    SONAR_VERSION="${SONARQUBE_VERSION}" \
    SQ_DATA_DIR="/opt/sonarqube/data" \
    SQ_EXTENSIONS_DIR="/opt/sonarqube/extensions" \
    SQ_LOGS_DIR="/opt/sonarqube/logs" \
    SQ_TEMP_DIR="/opt/sonarqube/temp"

# Separate stage to use variable expansion
ENV ES_TMPDIR="${SQ_TEMP_DIR}"

# Security updates: these packages are named explicitly so apt upgrades them to the
# current Noble candidate. Exact version pins (verified 2026-09-09) were dropped
# because Noble GCs superseded patch versions within weeks ("Version ... was not
# found"); security updates are monotonic, so the current
# candidate is >= the old pin and keeps the same CVE fixes.
RUN set -eux; \
    deluser ubuntu; \
    useradd --system --uid 1000 --gid 0 sonarqube; \
    apt-get update; \
    apt-get --no-install-recommends -y install \
        bash \
        fonts-dejavu \
        gnupg \
        gpgv \
        unzip \
        curl \
        dpkg \
        libcurl4t64 \
        libexpat1 \
        libgcrypt20 \
        liblzma5 \
        libnghttp2-14 \
        openssl \
        libssl3t64 \
        libfreetype6 \
        libgnutls30t64 \
        libpng16-16t64 \
        libssh-4 \
        libsystemd0 \
        libudev1 \
        libcap2 \
        coreutils \
        libbz2-1.0 \
        libncursesw6 \
        libtinfo6 \
        ncurses-base \
        ncurses-bin \
        zlib1g \
        util-linux \
        bsdutils \
        libblkid1 \
        libmount1 \
        libsmartcols1 \
        libuuid1 \
        mount \
        diffutils \
        gzip \
        libattr1 \
        libc-bin \
        libc6 \
        locales \
        libkrb5-3 \
        libgssapi-krb5-2 \
        libk5crypto3 \
        libkrb5support0 \
        p11-kit \
        libp11-kit0 \
        p11-kit-modules \
        libpam0g \
        libpam-modules \
        libpam-modules-bin \
        libpam-runtime \
        libsqlite3-0 \
        perl-base \
        tar \
        wget \
        sed;

COPY --chown=sonarqube:sonarqube source/sonar-application/build/distributions/sonar-application-${SONARQUBE_VERSION}.zip /home/sonarsource/
COPY --chown=sonarqube:sonarqube --chmod=555 image/community-build/jar-tools.sh /tmp/jar-tools.sh

RUN set -eux; \
    echo "networkaddress.cache.ttl=5" >> "${JAVA_HOME}/conf/security/java.security"; \
    sed --in-place --expression="s?securerandom.source=file:/dev/random?securerandom.source=file:/dev/urandom?g" "${JAVA_HOME}/conf/security/java.security"; \
    # pub   2048R/D26468DE 2015-05-25
    #       Key fingerprint = F118 2E81 C792 9289 21DB  CAB4 CFCA 4A29 D264 68DE
    # uid                  sonarsource_deployer (Sonarsource Deployer) <infra@sonarsource.com>
    # sub   2048R/06855C1D 2015-05-25
    unzip -q /home/sonarsource/sonar-application-${SONARQUBE_VERSION}.zip; \
    mv "sonarqube-${SONARQUBE_VERSION}" /opt/sonarqube; \
    rm /home/sonarsource/sonar-application-${SONARQUBE_VERSION}.zip*; \
    rm -rf ${SONARQUBE_HOME}/bin/*; \
    ln -s "${SONARQUBE_HOME}/lib/sonar-application-${SONARQUBE_VERSION}.jar" "${SONARQUBE_HOME}/lib/sonarqube.jar"; \
    chown -R sonarqube:root ${SONARQUBE_HOME}; \
    chown -R sonarqube:root "${SQ_DATA_DIR}" "${SQ_EXTENSIONS_DIR}" "${SQ_LOGS_DIR}" "${SQ_TEMP_DIR}"; \
    chmod -R 550 ${SONARQUBE_HOME}; \
    chmod -R 770 "${SQ_DATA_DIR}" "${SQ_EXTENSIONS_DIR}" "${SQ_LOGS_DIR}" "${SQ_TEMP_DIR}"; \
    apt-get remove -y gnupg unzip; \
    rm -rf /var/lib/apt/lists/*;

# The bundled sonar-application zip only contains the linux-x86_64 Elasticsearch
# tarball (source/sonar-application/build.gradle:90 hardcodes -linux-x86_64), so the
# arm64 image is missing lib/platform/linux-aarch64/*.so and ES 8.19 NativeAccess
# crashes on aarch64 hosts (UnsatisfiedLinkError libzstd.so). Overlay the aarch64
# platform natives from the matching elastic.co tarball at image-build time when
# TARGETARCH=arm64. Introduced by fc4f4b51 (migrate to edge-build PaC, multi-arch)
# without teaching the upstream gradle build to fetch the aarch64 tarball.
ARG TARGETARCH
# Keep in lockstep with elasticSearchServerVersion in source/gradle.properties.
ARG ES_VERSION=8.19.23
RUN set -eux; \
    if [ "${TARGETARCH:-$(dpkg --print-architecture)}" = "arm64" ]; then \
        cd /tmp; \
        curl -fsSLO "https://artifacts.elastic.co/downloads/elasticsearch/elasticsearch-${ES_VERSION}-linux-aarch64.tar.gz"; \
        tar -xzf "elasticsearch-${ES_VERSION}-linux-aarch64.tar.gz" \
            -C /tmp \
            "elasticsearch-${ES_VERSION}/lib/platform/linux-aarch64"; \
        cp -a "/tmp/elasticsearch-${ES_VERSION}/lib/platform/linux-aarch64" \
            "${SONARQUBE_HOME}/elasticsearch/lib/platform/"; \
        chown -R sonarqube:root "${SONARQUBE_HOME}/elasticsearch/lib/platform/linux-aarch64"; \
        chmod -R 550 "${SONARQUBE_HOME}/elasticsearch/lib/platform/linux-aarch64"; \
        rm -rf "/tmp/elasticsearch-${ES_VERSION}"* "/tmp/elasticsearch-${ES_VERSION}-linux-aarch64.tar.gz"; \
    fi

# ES 8.19.23 ships Netty 4.1.138.Final (past the CVE-2026-59903 fix in 4.1.137) and
# jackson 2.21.7, so the netty / jackson replacements for 8.19.21 are gone. lz4-java
# is still 1.11.1 there (CVE-2026-106451, fixed in 1.11.4).
# renovate: datasource=maven depName=lz4-java lookupName=at.yawk.lz4:lz4-java
ARG LZ4_JAVA_VERSION=1.11.4
RUN set -eux; \
    test -f "${SONARQUBE_HOME}/elasticsearch/lib/lz4-java-1.11.1.jar"; \
    /tmp/jar-tools.sh replace "at.yawk.lz4" "lz4-java" 1.11.1 "$LZ4_JAVA_VERSION" "${SONARQUBE_HOME}/elasticsearch/lib"

# ES 8.19 bundles elastic-apm-agent 1.55.x with a vulnerable Log4j API.
# renovate: datasource=maven depName=elastic-apm-agent-java8 lookupName=co.elastic.apm:elastic-apm-agent-java8
ARG ELASTIC_APM_AGENT_VERSION=1.57.0
RUN set -eux; \
    for agent in "${SONARQUBE_HOME}"/elasticsearch/modules/apm/elastic-apm-agent-java8-*.jar; do \
        test -f "$agent"; \
        curl -fsSL -o "$agent" "https://repo1.maven.org/maven2/co/elastic/apm/elastic-apm-agent-java8/${ELASTIC_APM_AGENT_VERSION}/elastic-apm-agent-java8-${ELASTIC_APM_AGENT_VERSION}.jar"; \
    done

# renovate: datasource=maven depName=commons-lang3 lookupName=org.apache.commons:commons-lang3
ARG COMMONS_LANG3_VERSION=3.18.0
RUN set -eux; \
    /tmp/jar-tools.sh replace "org.apache.commons" "commons-lang3" 3.9 "$COMMONS_LANG3_VERSION" "${SONARQUBE_HOME}/elasticsearch/modules/x-pack-inference/"

# renovate: datasource=maven depName=jackson-core lookupName=com.fasterxml.jackson.core:jackson-core
ARG JACKSON_CORE_FIXED_VERSION=2.21.7
RUN set -eux; \
    /tmp/jar-tools.sh overlay-from-maven "com.fasterxml.jackson.core" "jackson-core" "$JACKSON_CORE_FIXED_VERSION" "${SONARQUBE_HOME}/lib/sonar-application-${SONARQUBE_VERSION}.jar"

COPY --chown=root:root --chmod=555 image/community-build/entrypoint.sh ${SONARQUBE_HOME}/docker/

# CVE-2025-13465: patch lodash baseUnset to prevent prototype pollution via _.unset / _.omit
COPY --chown=root:root --chmod=555 image/community-build/patch-lodash-cve-2025-13465.py /tmp/patch-lodash-cve-2025-13465.py
# Replace every upstream SonarQube mark in the webapp with the
# neutral ACP icon and wire the trademark-notice footer script; apply_brand.py fails
# the build if any brand file or inline logo component is left over. The same step
# runs on the branch-plugin webapp in image/plugin/Containerfile.
COPY --chown=root:root image/brand /tmp/alauda-brand
RUN apt-get update && apt-get install -y --no-install-recommends python3 && \
    python3 /tmp/patch-lodash-cve-2025-13465.py && \
    python3 /tmp/alauda-brand/apply_brand.py "${SONARQUBE_HOME}/web" && \
    chown -R sonarqube:root "${SONARQUBE_HOME}/web" && \
    chmod -R 550 "${SONARQUBE_HOME}/web" && \
    apt-get purge -y --auto-remove python3 python3-minimal && \
    rm -rf /var/lib/apt/lists/* /tmp/alauda-brand

# License texts at /licenses (verify: docker run --rm --entrypoint sh <image> -c 'ls /licenses; cat /licenses/*').
# Create the directory first: COPY --chmod would otherwise apply 444 to the implicit
# parent directory too, leaving /licenses unreadable for the sonarqube user.
RUN install -d -m 0755 /licenses
COPY --chown=root:root --chmod=444 source/LICENSE.txt /licenses/LICENSE
COPY --chown=root:root --chmod=444 source/NOTICE.txt /licenses/NOTICE
COPY --chown=root:root --chmod=444 image/licenses/community-build/README /licenses/README
RUN set -eux; \
    for f in LICENSE.txt NOTICE.txt; do \
        install -m 444 "${SONARQUBE_HOME}/elasticsearch/${f}" "/licenses/ELASTICSEARCH-${f}"; \
    done

# remove sniff tools
RUN set +e; \
  ls -d /usr/bin/* | grep -E "cpp|readelf|gcc|nc|netcat" | xargs rm; \
  rm /usr/lib/apt/methods/mirror

FROM registry-cache.alauda.io/library/eclipse-temurin:21-jdk-noble

COPY --from=builder / /

LABEL io.k8s.description="SonarQube Community Build is a self-managed, automatic code review tool that systematically helps you deliver Clean Code."
LABEL io.openshift.min-cpu=400m
LABEL io.openshift.min-memory=2048M
LABEL io.openshift.non-scalable=true
LABEL io.openshift.tags=sonarqube,static-code-analysis,code-quality,clean-code
LABEL org.opencontainers.image.vendor="Alauda"
LABEL org.opencontainers.image.source=https://github.com/SonarSource/sonarqube

ENV LANG='en_US.UTF-8' \
    LANGUAGE='en_US:en' \
    LC_ALL='en_US.UTF-8'

#
# SonarQube setup
#
ARG SONARQUBE_VERSION=26.1.0.118079
ENV DOCKER_RUNNING="true" \
    JAVA_HOME='/opt/java/openjdk' \
    SONARQUBE_HOME=/opt/sonarqube \
    SONAR_VERSION="${SONARQUBE_VERSION}" \
    SQ_DATA_DIR="/opt/sonarqube/data" \
    SQ_EXTENSIONS_DIR="/opt/sonarqube/extensions" \
    SQ_LOGS_DIR="/opt/sonarqube/logs" \
    SQ_TEMP_DIR="/opt/sonarqube/temp"

# Separate stage to use variable expansion
ENV ES_TMPDIR="${SQ_TEMP_DIR}"

VOLUME ["${SQ_DATA_DIR}", "${SQ_EXTENSIONS_DIR}", "${SQ_LOGS_DIR}", "${SQ_TEMP_DIR}"]

WORKDIR ${SONARQUBE_HOME}
EXPOSE 9000

USER sonarqube
STOPSIGNAL SIGINT

ENTRYPOINT ["/opt/sonarqube/docker/entrypoint.sh"]
