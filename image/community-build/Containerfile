FROM hub-mirrors.alauda.cn/library/eclipse-temurin:21-jdk-noble AS builder

ENV LANG='en_US.UTF-8' \
    LANGUAGE='en_US:en' \
    LC_ALL='en_US.UTF-8'

#
# SonarQube setup
#
ARG SONARQUBE_VERSION=26.1.0.118079
ENV DOCKER_RUNNING="true" \
    JAVA_HOME='/opt/java/openjdk' \
    SONARQUBE_HOME=/opt/sonarqube \
    SONAR_VERSION="${SONARQUBE_VERSION}" \
    SQ_DATA_DIR="/opt/sonarqube/data" \
    SQ_EXTENSIONS_DIR="/opt/sonarqube/extensions" \
    SQ_LOGS_DIR="/opt/sonarqube/logs" \
    SQ_TEMP_DIR="/opt/sonarqube/temp"

# Separate stage to use variable expansion
ENV ES_TMPDIR="${SQ_TEMP_DIR}"

RUN set -eux; \
    deluser ubuntu; \
    useradd --system --uid 1000 --gid 0 sonarqube; \
    apt-get update; \
    apt-get --no-install-recommends -y install \
        bash \
        fonts-dejavu \
        gnupg \
        unzip \
        curl=8.5.0-2ubuntu10.9 \
        dpkg=1.22.6ubuntu6.6 \
        libcurl4t64=8.5.0-2ubuntu10.9 \
        libgcrypt20=1.10.3-2ubuntu0.1 \
        liblzma5=5.6.1+really5.4.5-1ubuntu0.3 \
        libnghttp2-14=1.59.0-1ubuntu0.3 \
        openssl=3.0.13-0ubuntu3.11 \
        libssl3t64=3.0.13-0ubuntu3.11 \
        libfreetype6=2.13.2+dfsg-1ubuntu0.1 \
        libgnutls30t64=3.8.3-1.1ubuntu3.6 \
        libpng16-16t64=1.6.43-5ubuntu0.6 \
        libssh-4=0.10.6-2ubuntu0.4 \
        libsystemd0=255.4-1ubuntu8.16 \
        libudev1=255.4-1ubuntu8.16 \
        libcap2=1:2.66-5ubuntu2.4 \
        sed=4.9-2ubuntu0.24.04.1;

COPY --chown=sonarsource:sonarsource source/sonar-application/build/distributions/sonar-application-${SONARQUBE_VERSION}.zip /home/sonarsource/
COPY --chown=sonarsource:sonarsource --chmod=555 image/community-build/jar-tools.sh /tmp/jar-tools.sh

RUN set -eux; \
    echo "networkaddress.cache.ttl=5" >> "${JAVA_HOME}/conf/security/java.security"; \
    sed --in-place --expression="s?securerandom.source=file:/dev/random?securerandom.source=file:/dev/urandom?g" "${JAVA_HOME}/conf/security/java.security"; \
    # pub   2048R/D26468DE 2015-05-25
    #       Key fingerprint = F118 2E81 C792 9289 21DB  CAB4 CFCA 4A29 D264 68DE
    # uid                  sonarsource_deployer (Sonarsource Deployer) <infra@sonarsource.com>
    # sub   2048R/06855C1D 2015-05-25
    unzip -q /home/sonarsource/sonar-application-${SONARQUBE_VERSION}.zip; \
    mv "sonarqube-${SONARQUBE_VERSION}" /opt/sonarqube; \
    rm /home/sonarsource/sonar-application-${SONARQUBE_VERSION}.zip*; \
    rm -rf ${SONARQUBE_HOME}/bin/*; \
    ln -s "${SONARQUBE_HOME}/lib/sonar-application-${SONARQUBE_VERSION}.jar" "${SONARQUBE_HOME}/lib/sonarqube.jar"; \
    chown -R sonarqube:root ${SONARQUBE_HOME}; \
    chown -R sonarqube:root "${SQ_DATA_DIR}" "${SQ_EXTENSIONS_DIR}" "${SQ_LOGS_DIR}" "${SQ_TEMP_DIR}"; \
    chmod -R 550 ${SONARQUBE_HOME}; \
    chmod -R 770 "${SQ_DATA_DIR}" "${SQ_EXTENSIONS_DIR}" "${SQ_LOGS_DIR}" "${SQ_TEMP_DIR}"; \
    apt-get remove -y gnupg unzip; \
    rm -rf /var/lib/apt/lists/*;

# renovate: datasource=maven depName=commons-lang3 lookupName=org.apache.commons:commons-lang3
ARG COMMONS_LANG3_VERSION=3.20.0
# renovate: datasource=maven depName=jackson-core lookupName=com.fasterxml.jackson.core:jackson-core
ARG JACKSON_CORE_FIXED_VERSION=2.21.2
RUN set -eux; \
    /tmp/jar-tools.sh replace "org.apache.commons" "commons-lang3" 3.9 "$COMMONS_LANG3_VERSION" "${SONARQUBE_HOME}/elasticsearch/modules/x-pack-inference/"; \
    /tmp/jar-tools.sh replace "com.fasterxml.jackson.core" "jackson-core" 2.15.0 2.18.6 "${SONARQUBE_HOME}/elasticsearch/modules/x-pack-inference/"; \
    /tmp/jar-tools.sh overlay-from-maven "com.fasterxml.jackson.core" "jackson-core" "${JACKSON_CORE_FIXED_VERSION}" "${SONARQUBE_HOME}/lib/extensions/sonar-python-plugin-5.19.0.32098.jar"; \
    /tmp/jar-tools.sh overlay-from-maven "com.fasterxml.jackson.core" "jackson-core" "${JACKSON_CORE_FIXED_VERSION}" "${SONARQUBE_HOME}/elasticsearch/bin/elasticsearch-sql-cli-8.19.13.jar"; \
    /tmp/jar-tools.sh overlay-from-maven "com.fasterxml.jackson.core" "jackson-core" "${JACKSON_CORE_FIXED_VERSION}" "${SONARQUBE_HOME}/elasticsearch/lib/elasticsearch-x-content-8.19.13.jar" "IMPL-JARS/x-content/jackson-core-2.17.2.jar"; \
    /tmp/jar-tools.sh overlay-from-maven "com.fasterxml.jackson.core" "jackson-core" "${JACKSON_CORE_FIXED_VERSION}" "${SONARQUBE_HOME}/elasticsearch/lib/tools/plugin-cli/elasticsearch-x-content-8.19.13.jar" "IMPL-JARS/x-content/jackson-core-2.17.2.jar"; \
    /tmp/jar-tools.sh overlay-from-maven "com.fasterxml.jackson.core" "jackson-core" "${JACKSON_CORE_FIXED_VERSION}" "${SONARQUBE_HOME}/lib/sonar-application-${SONARQUBE_VERSION}.jar"

# Patch additional CVE-laden standalone jars bundled inside the Elasticsearch distribution.
# Versions are pinned to the closest fix per Trivy advisory and cross-checked for binary compat.
# renovate: datasource=maven depName=netty-codec-http lookupName=io.netty:netty-codec-http
ARG NETTY_VERSION=4.1.135.Final
# renovate: datasource=maven depName=jakarta.mail lookupName=com.sun.mail:jakarta.mail
ARG JAKARTA_MAIL_VERSION=1.6.8
# renovate: datasource=maven depName=log4j-core lookupName=org.apache.logging.log4j:log4j-core
ARG LOG4J_VERSION=2.25.4
# renovate: datasource=maven depName=bcprov-jdk18on lookupName=org.bouncycastle:bcprov-jdk18on
ARG BOUNCYCASTLE_VERSION=1.84
# renovate: datasource=maven depName=elastic-apm-agent-java8 lookupName=co.elastic.apm:elastic-apm-agent-java8
ARG APM_AGENT_VERSION=1.55.6
RUN set -eux; \
    # Verify a Maven artifact against its published .sha1 sidecar before swapping it in. \
    # (Maven Central exposes .sha1 for every artifact; .sha256/.sha512 are not always present.) \
    verify_sha1() { \
        file="$1" url="$2"; \
        expected=$(curl -fsSL "${url}.sha1" | tr -d '[:space:]' | cut -c1-40); \
        actual=$(sha1sum "$file" | cut -d' ' -f1); \
        [ "$expected" = "$actual" ] || { echo "sha1 mismatch for $file (expected=$expected actual=$actual)" >&2; return 1; }; \
    }; \
    for d in ${SONARQUBE_HOME}/elasticsearch/modules/transport-netty4 \
             ${SONARQUBE_HOME}/elasticsearch/modules/x-pack-inference \
             ${SONARQUBE_HOME}/elasticsearch/modules/x-pack-security; do \
        /tmp/jar-tools.sh replace "io.netty" "netty-codec" 4.1.130.Final "$NETTY_VERSION" "$d"; \
        /tmp/jar-tools.sh replace "io.netty" "netty-codec-http" 4.1.130.Final "$NETTY_VERSION" "$d"; \
        /tmp/jar-tools.sh replace "io.netty" "netty-handler" 4.1.130.Final "$NETTY_VERSION" "$d"; \
    done; \
    /tmp/jar-tools.sh replace "io.netty" "netty-codec-http2" 4.1.130.Final "$NETTY_VERSION" "${SONARQUBE_HOME}/elasticsearch/modules/x-pack-inference"; \
    /tmp/jar-tools.sh replace "io.netty" "netty-codec-dns" 4.1.130.Final "$NETTY_VERSION" "${SONARQUBE_HOME}/elasticsearch/modules/x-pack-inference"; \
    /tmp/jar-tools.sh replace "io.netty" "netty-resolver-dns" 4.1.130.Final "$NETTY_VERSION" "${SONARQUBE_HOME}/elasticsearch/modules/x-pack-inference"; \
    /tmp/jar-tools.sh replace "io.opentelemetry" "opentelemetry-api" 1.31.0 1.62.0 "${SONARQUBE_HOME}/elasticsearch/modules/apm"; \
    /tmp/jar-tools.sh replace "com.sun.mail" "jakarta.mail" 1.6.3 "$JAKARTA_MAIL_VERSION" "${SONARQUBE_HOME}/elasticsearch/modules/x-pack-security"; \
    /tmp/jar-tools.sh replace "org.apache.logging.log4j" "log4j-1.2-api" 2.19.0 "$LOG4J_VERSION" "${SONARQUBE_HOME}/elasticsearch/modules/x-pack-core"; \
    # Keep the rest of the log4j family aligned with log4j-core ($LOG4J_VERSION) — \
    # the new log4j-core requires API methods added after 2.19.0, otherwise ES boot \
    # fails with NoSuchMethodError on LoaderUtil.newCheckedInstanceOfProperty. \
    /tmp/jar-tools.sh replace "org.apache.logging.log4j" "log4j-api" 2.19.0 "$LOG4J_VERSION" "${SONARQUBE_HOME}/elasticsearch/lib"; \
    /tmp/jar-tools.sh replace "org.apache.logging.log4j" "log4j-slf4j2-impl" 2.19.0 "$LOG4J_VERSION" "${SONARQUBE_HOME}/elasticsearch/modules/x-pack-core"; \
    /tmp/jar-tools.sh replace "org.bouncycastle" "bcpkix-jdk18on" 1.79 "$BOUNCYCASTLE_VERSION" "${SONARQUBE_HOME}/elasticsearch/lib/tools/security-cli"; \
    /tmp/jar-tools.sh replace "org.bouncycastle" "bcprov-jdk18on" 1.79 "$BOUNCYCASTLE_VERSION" "${SONARQUBE_HOME}/elasticsearch/lib/tools/security-cli"; \
    # elasticsearch-log4j-${esVer}.jar is just log4j-core renamed; replace contents with the fixed log4j-core (CVE-2025-68161, CVE-2026-34477, CVE-2026-34480). \
    ES_LOG4J_FILE=$(ls ${SONARQUBE_HOME}/elasticsearch/lib/elasticsearch-log4j-*.jar); \
    ES_LOG4J_URL="https://repo1.maven.org/maven2/org/apache/logging/log4j/log4j-core/${LOG4J_VERSION}/log4j-core-${LOG4J_VERSION}.jar"; \
    curl -fsSL -o "$ES_LOG4J_FILE" "$ES_LOG4J_URL"; \
    verify_sha1 "$ES_LOG4J_FILE" "$ES_LOG4J_URL"; \
    # Replace bundled elastic-apm-agent-java8 (shades log4j-core 2.25.0) with patched 1.55.6 (CVE-2025-68161, CVE-2026-34477/8/0). \
    APM_AGENT_FILE=$(ls ${SONARQUBE_HOME}/elasticsearch/modules/apm/elastic-apm-agent-java8-*.jar); \
    APM_AGENT_URL="https://repo1.maven.org/maven2/co/elastic/apm/elastic-apm-agent-java8/${APM_AGENT_VERSION}/elastic-apm-agent-java8-${APM_AGENT_VERSION}.jar"; \
    curl -fsSL -o "$APM_AGENT_FILE" "$APM_AGENT_URL"; \
    verify_sha1 "$APM_AGENT_FILE" "$APM_AGENT_URL"

COPY --chown=root:root --chmod=555 image/community-build/entrypoint.sh ${SONARQUBE_HOME}/docker/

# CVE-2025-13465: patch lodash baseUnset to prevent prototype pollution via _.unset / _.omit
COPY --chown=root:root --chmod=555 image/community-build/patch-lodash-cve-2025-13465.py /tmp/patch-lodash-cve-2025-13465.py
RUN apt-get update && apt-get install -y --no-install-recommends python3-minimal && \
    python3 /tmp/patch-lodash-cve-2025-13465.py && \
    apt-get remove -y python3-minimal && \
    rm -rf /var/lib/apt/lists/*

# remove sniff tools
RUN set +e; \
  ls -d /usr/bin/* | grep -E "cpp|readelf|gcc|nc|netcat" | xargs rm; \
  rm /usr/lib/apt/methods/mirror

FROM hub-mirrors.alauda.cn/library/eclipse-temurin:21-jdk-noble

COPY --from=builder / /

LABEL io.k8s.description="SonarQube Community Build is a self-managed, automatic code review tool that systematically helps you deliver Clean Code."
LABEL io.openshift.min-cpu=400m
LABEL io.openshift.min-memory=2048M
LABEL io.openshift.non-scalable=true
LABEL io.openshift.tags=sonarqube,static-code-analysis,code-quality,clean-code
LABEL org.opencontainers.image.url=https://github.com/SonarSource/docker-sonarqube

ENV LANG='en_US.UTF-8' \
    LANGUAGE='en_US:en' \
    LC_ALL='en_US.UTF-8'

#
# SonarQube setup
#
ARG SONARQUBE_VERSION=26.1.0.118079
ENV DOCKER_RUNNING="true" \
    JAVA_HOME='/opt/java/openjdk' \
    SONARQUBE_HOME=/opt/sonarqube \
    SONAR_VERSION="${SONARQUBE_VERSION}" \
    SQ_DATA_DIR="/opt/sonarqube/data" \
    SQ_EXTENSIONS_DIR="/opt/sonarqube/extensions" \
    SQ_LOGS_DIR="/opt/sonarqube/logs" \
    SQ_TEMP_DIR="/opt/sonarqube/temp"

# Separate stage to use variable expansion
ENV ES_TMPDIR="${SQ_TEMP_DIR}"

VOLUME ["${SQ_DATA_DIR}", "${SQ_EXTENSIONS_DIR}", "${SQ_LOGS_DIR}", "${SQ_TEMP_DIR}"]

WORKDIR ${SONARQUBE_HOME}
EXPOSE 9000

USER sonarqube
STOPSIGNAL SIGINT

ENTRYPOINT ["/opt/sonarqube/docker/entrypoint.sh"]
