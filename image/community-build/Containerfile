FROM hub-mirrors.alauda.cn/library/eclipse-temurin:21-jdk-noble AS builder

ENV LANG='en_US.UTF-8' \
    LANGUAGE='en_US:en' \
    LC_ALL='en_US.UTF-8'

#
# SonarQube setup
#
ARG SONARQUBE_VERSION=26.1.0.118079
ENV DOCKER_RUNNING="true" \
    JAVA_HOME='/opt/java/openjdk' \
    SONARQUBE_HOME=/opt/sonarqube \
    SONAR_VERSION="${SONARQUBE_VERSION}" \
    SQ_DATA_DIR="/opt/sonarqube/data" \
    SQ_EXTENSIONS_DIR="/opt/sonarqube/extensions" \
    SQ_LOGS_DIR="/opt/sonarqube/logs" \
    SQ_TEMP_DIR="/opt/sonarqube/temp"

# Separate stage to use variable expansion
ENV ES_TMPDIR="${SQ_TEMP_DIR}"

RUN set -eux; \
    deluser ubuntu; \
    useradd --system --uid 1000 --gid 0 sonarqube; \
    apt-get update; \
    apt-get --no-install-recommends -y install \
        bash \
        fonts-dejavu \
        gnupg \
        unzip \
        curl=8.5.0-2ubuntu10.9 \
        dpkg=1.22.6ubuntu6.6 \
        libcurl4t64=8.5.0-2ubuntu10.9 \
        libgcrypt20=1.10.3-2ubuntu0.1 \
        liblzma5=5.6.1+really5.4.5-1ubuntu0.3 \
        libnghttp2-14=1.59.0-1ubuntu0.3 \
        openssl=3.0.13-0ubuntu3.11 \
        libssl3t64=3.0.13-0ubuntu3.11 \
        libfreetype6=2.13.2+dfsg-1ubuntu0.1 \
        libgnutls30t64=3.8.3-1.1ubuntu3.6 \
        libpng16-16t64=1.6.43-5ubuntu0.6 \
        libssh-4=0.10.6-2ubuntu0.4 \
        libsystemd0=255.4-1ubuntu8.16 \
        libudev1=255.4-1ubuntu8.16 \
        libcap2=1:2.66-5ubuntu2.4 \
        sed=4.9-2ubuntu0.24.04.1;

COPY --chown=sonarsource:sonarsource source/sonar-application/build/distributions/sonar-application-${SONARQUBE_VERSION}.zip /home/sonarsource/
COPY --chown=sonarsource:sonarsource --chmod=555 image/community-build/jar-tools.sh /tmp/jar-tools.sh
COPY --chown=sonarsource:sonarsource image/community-build/vendor-jars/ /tmp/vendor-jars/

RUN set -eux; \
    echo "networkaddress.cache.ttl=5" >> "${JAVA_HOME}/conf/security/java.security"; \
    sed --in-place --expression="s?securerandom.source=file:/dev/random?securerandom.source=file:/dev/urandom?g" "${JAVA_HOME}/conf/security/java.security"; \
    # pub   2048R/D26468DE 2015-05-25
    #       Key fingerprint = F118 2E81 C792 9289 21DB  CAB4 CFCA 4A29 D264 68DE
    # uid                  sonarsource_deployer (Sonarsource Deployer) <infra@sonarsource.com>
    # sub   2048R/06855C1D 2015-05-25
    unzip -q /home/sonarsource/sonar-application-${SONARQUBE_VERSION}.zip; \
    mv "sonarqube-${SONARQUBE_VERSION}" /opt/sonarqube; \
    rm /home/sonarsource/sonar-application-${SONARQUBE_VERSION}.zip*; \
    rm -rf ${SONARQUBE_HOME}/bin/*; \
    ln -s "${SONARQUBE_HOME}/lib/sonar-application-${SONARQUBE_VERSION}.jar" "${SONARQUBE_HOME}/lib/sonarqube.jar"; \
    chown -R sonarqube:root ${SONARQUBE_HOME}; \
    chown -R sonarqube:root "${SQ_DATA_DIR}" "${SQ_EXTENSIONS_DIR}" "${SQ_LOGS_DIR}" "${SQ_TEMP_DIR}"; \
    chmod -R 550 ${SONARQUBE_HOME}; \
    chmod -R 770 "${SQ_DATA_DIR}" "${SQ_EXTENSIONS_DIR}" "${SQ_LOGS_DIR}" "${SQ_TEMP_DIR}"; \
    apt-get remove -y gnupg unzip; \
    rm -rf /var/lib/apt/lists/*;

# Jars pre-downloaded to vendor-jars/ to avoid runtime network dependency during build.
# ES 8.19.16 ships netty 4.1.133.Final; several artifacts still need 4.1.135.Final.
RUN set -eux; \
    replace_local() { \
        old_name="$1" new_jar="/tmp/vendor-jars/$2"; \
        find "$3" -name "$old_name" -type f | while read -r f; do \
            cp "$new_jar" "$(dirname "$f")/$(basename "$new_jar")"; \
            rm -f "$f"; \
            echo "[INFO] Replaced: $old_name -> $(basename "$new_jar") in $(dirname "$f")"; \
        done; \
    }; \
    for d in ${SONARQUBE_HOME}/elasticsearch/modules/transport-netty4 \
             ${SONARQUBE_HOME}/elasticsearch/modules/x-pack-inference \
             ${SONARQUBE_HOME}/elasticsearch/modules/x-pack-security; do \
        replace_local "netty-handler-4.1.133.Final.jar"   "netty-handler-4.1.135.Final.jar"   "$d"; \
        replace_local "netty-codec-http-4.1.133.Final.jar" "netty-codec-http-4.1.135.Final.jar" "$d"; \
    done; \
    replace_local "netty-codec-http2-4.1.133.Final.jar"  "netty-codec-http2-4.1.135.Final.jar"  "${SONARQUBE_HOME}/elasticsearch/modules/x-pack-inference"; \
    replace_local "netty-resolver-dns-4.1.133.Final.jar" "netty-resolver-dns-4.1.135.Final.jar" "${SONARQUBE_HOME}/elasticsearch/modules/x-pack-inference"; \
    replace_local "commons-lang3-3.9.jar"  "commons-lang3-3.18.0.jar"  "${SONARQUBE_HOME}/elasticsearch/modules/x-pack-inference"; \
    replace_local "jakarta.mail-1.6.3.jar" "jakarta.mail-1.6.8.jar"    "${SONARQUBE_HOME}/elasticsearch/modules/x-pack-security"; \
    replace_local "jackson-core-2.15.0.jar" "jackson-core-2.21.2.jar"  "${SONARQUBE_HOME}/elasticsearch/modules/x-pack-inference"; \
    /tmp/jar-tools.sh overlay /tmp/vendor-jars/jackson-core-2.21.2.jar \
        "${SONARQUBE_HOME}/elasticsearch/bin/elasticsearch-sql-cli-8.19.16.jar"; \
    /tmp/jar-tools.sh overlay /tmp/vendor-jars/jackson-core-2.21.2.jar \
        "${SONARQUBE_HOME}/elasticsearch/lib/elasticsearch-x-content-8.19.16.jar" \
        "IMPL-JARS/x-content/jackson-core-2.17.2.jar"; \
    /tmp/jar-tools.sh overlay /tmp/vendor-jars/jackson-core-2.21.2.jar \
        "${SONARQUBE_HOME}/elasticsearch/lib/tools/plugin-cli/elasticsearch-x-content-8.19.16.jar" \
        "IMPL-JARS/x-content/jackson-core-2.17.2.jar"; \
    /tmp/jar-tools.sh overlay /tmp/vendor-jars/jackson-core-2.21.2.jar \
        "${SONARQUBE_HOME}/lib/sonar-application-${SONARQUBE_VERSION}.jar"; \
    /tmp/jar-tools.sh overlay /tmp/vendor-jars/jackson-core-2.21.2.jar \
        "${SONARQUBE_HOME}/lib/extensions/sonar-python-plugin-5.19.0.32098.jar"; \
    rm -rf /tmp/vendor-jars

COPY --chown=root:root --chmod=555 image/community-build/entrypoint.sh ${SONARQUBE_HOME}/docker/

# CVE-2025-13465: patch lodash baseUnset to prevent prototype pollution via _.unset / _.omit
COPY --chown=root:root --chmod=555 image/community-build/patch-lodash-cve-2025-13465.py /tmp/patch-lodash-cve-2025-13465.py
RUN apt-get update && apt-get install -y --no-install-recommends python3-minimal && \
    python3 /tmp/patch-lodash-cve-2025-13465.py && \
    apt-get remove -y python3-minimal && \
    rm -rf /var/lib/apt/lists/*

# remove sniff tools
RUN set +e; \
  ls -d /usr/bin/* | grep -E "cpp|readelf|gcc|nc|netcat" | xargs rm; \
  rm /usr/lib/apt/methods/mirror

FROM hub-mirrors.alauda.cn/library/eclipse-temurin:21-jdk-noble

COPY --from=builder / /

LABEL io.k8s.description="SonarQube Community Build is a self-managed, automatic code review tool that systematically helps you deliver Clean Code."
LABEL io.openshift.min-cpu=400m
LABEL io.openshift.min-memory=2048M
LABEL io.openshift.non-scalable=true
LABEL io.openshift.tags=sonarqube,static-code-analysis,code-quality,clean-code
LABEL org.opencontainers.image.url=https://github.com/SonarSource/docker-sonarqube

ENV LANG='en_US.UTF-8' \
    LANGUAGE='en_US:en' \
    LC_ALL='en_US.UTF-8'

#
# SonarQube setup
#
ARG SONARQUBE_VERSION=26.1.0.118079
ENV DOCKER_RUNNING="true" \
    JAVA_HOME='/opt/java/openjdk' \
    SONARQUBE_HOME=/opt/sonarqube \
    SONAR_VERSION="${SONARQUBE_VERSION}" \
    SQ_DATA_DIR="/opt/sonarqube/data" \
    SQ_EXTENSIONS_DIR="/opt/sonarqube/extensions" \
    SQ_LOGS_DIR="/opt/sonarqube/logs" \
    SQ_TEMP_DIR="/opt/sonarqube/temp"

# Separate stage to use variable expansion
ENV ES_TMPDIR="${SQ_TEMP_DIR}"

VOLUME ["${SQ_DATA_DIR}", "${SQ_EXTENSIONS_DIR}", "${SQ_LOGS_DIR}", "${SQ_TEMP_DIR}"]

WORKDIR ${SONARQUBE_HOME}
EXPOSE 9000

USER sonarqube
STOPSIGNAL SIGINT

ENTRYPOINT ["/opt/sonarqube/docker/entrypoint.sh"]
