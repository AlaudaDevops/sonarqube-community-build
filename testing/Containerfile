# migration(sonarqube) P1/P2: hub-mirrors.alauda.cn (internal Docker Hub mirror,
# unreachable from edge-build) -> docker.io/library (literal, pulled direct) per the
# project-wide base-image rule D-5: registry-dev.alauda.io/base-images/golang does NOT
# exist (confirmed absent via authenticated Harbor v2 tags/list probe -- base-images/
# only carries alpine + debian today). Tag preserved verbatim (go.mod pins go 1.25.5).
FROM registry-cache.alauda.io/library/golang:1.25.5-bookworm AS builder

WORKDIR /app

COPY . /app

# migration(sonarqube) P1: build-nexus.alauda.cn/repository/golang/ is unreachable from
# edge-build (same host class as the gomod-proxy fix already applied on
# sonarqube-ce-operator@migration). ARG default is the literal resolved value of the
# {{ gomod_proxy }} PaC global (gomod.alauda.io, Athens) -- Containerfiles are NOT
# PaC-templated, so `{{ }}` cannot appear here; the .tekton pipeline also passes this
# same value via --build-arg (see integration-test.yaml), the ARG default is only the
# local/manual-build fallback.
ARG GOPROXY=https://gomod.alauda.io,direct
ENV GOPROXY=${GOPROXY}
ENV GOSUMDB=off

# migration(sonarqube) P1 (repo-local, reversible fix -- autonomy ladder 🟢, principle
# P1/P2): playwright-go's `install` subcommand shells out to the upstream Node
# playwright driver, whose default download host (playwright.azureedge.net) 404s from
# edge-build's network (Microsoft retired that CDN). Redirect to the npmmirror mirror,
# same fix already applied at the operator sibling (sonarqube-ce-operator's own
# .env.yarn: PLAYWRIGHT_DOWNLOAD_HOST=https://registry.npmmirror.com/-/binary/playwright).
# Declared as an ARG (with this file's own working default) so it also takes the
# --build-arg the integration-test PipelineRun passes, without requiring it.
ARG PLAYWRIGHT_DOWNLOAD_HOST=https://registry.npmmirror.com/-/binary/playwright
ENV PLAYWRIGHT_DOWNLOAD_HOST=${PLAYWRIGHT_DOWNLOAD_HOST}

RUN PWGO_VER=$(grep -oE "playwright-go v\S+" /app/testing/go.mod | sed 's/playwright-go //g') \
    && go install github.com/playwright-community/playwright-go/cmd/playwright@${PWGO_VER}
RUN set -eux \
    && mkdir -p /tools/bin && chmod -R 777 /tools/bin \
    && cd /app/testing \
    && go mod tidy \
    && CGO_ENABLED=1 go test -c -o /tools/bin/sonarqube-e2e.test ./


# migration(sonarqube) P1: build-harbor.alauda.cn/devops/sonarqube-ce-test-base ->
# {{ registry_url }}/alauda-devops-toolchain/sonarqube/sonarqube-ce-test-base (literal
# registry-dev.alauda.io host -- this Containerfile is NOT PaC-templated, `{{ }}` only
# expands inside .tekton/*.yaml). Built by .tekton/build-testing-base-image.yaml.
FROM registry-dev.alauda.io/alauda-devops-toolchain/sonarqube/sonarqube-ce-test-base:latest

RUN set -eux \
    && groupadd --gid 65532 nonroot \
    && useradd --uid 65532 --gid 65532 --shell /bin/bash --create-home nonroot

# migration(sonarqube): nss_wrapper lets the nonroot run-test process resolve the
# per-scenario ingress hostnames (added by scripts/add-host.sh into
# $NSS_WRAPPER_HOSTS) from the scan subprocesses (curl + the Java sonar-scanner)
# without writing the root-owned /etc/hosts. bdd fake DNS only covers its own Go
# client, so the ingress-http/https scan steps need this.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libnss-wrapper \
    && rm -rf /var/lib/apt/lists/*

COPY --chown=nonroot:nonroot ./chart /app/chart
COPY --chown=nonroot:nonroot ./testing /app/testing
COPY --chown=nonroot:nonroot --from=builder /tools/bin/sonarqube-e2e.test /app/bin/sonarqube-e2e.test
COPY --chown=nonroot:nonroot --from=builder /go/bin/playwright /app/bin/playwright

# migration(sonarqube): forward the same download-host override to the runtime install
# (this RUN executes in the final stage, a fresh ARG scope -- ARGs do not cross FROM
# boundaries in Dockerfile/Containerfile syntax).
ARG PLAYWRIGHT_DOWNLOAD_HOST=https://registry.npmmirror.com/-/binary/playwright
ENV PLAYWRIGHT_DOWNLOAD_HOST=${PLAYWRIGHT_DOWNLOAD_HOST}
RUN /app/bin/playwright install chromium --with-deps

# migration(sonarqube): install the Allure CLI so the pipeline report step can render
# the HTML report from the godog allure-results (same as the nexus e2e). Needs a JRE,
# which the test-base already ships (sonar-scanner is Java).
ARG ALLURE_VERSION=2.24.1
RUN wget -q https://github.com/allure-framework/allure2/releases/download/${ALLURE_VERSION}/allure-${ALLURE_VERSION}.tgz \
    && tar -zxf allure-${ALLURE_VERSION}.tgz -C /opt/ \
    && ln -s /opt/allure-${ALLURE_VERSION}/bin/allure /usr/local/bin/allure \
    && rm allure-${ALLURE_VERSION}.tgz

WORKDIR /app/testing

ENV PATH="${PATH}:/app/sonar-scanner/bin:/app/bin"
ENV CI=true
ENV LANG=zh_CN.UTF-8
ENV LC_ALL=zh_CN.UTF-8
# migration(sonarqube): force Go to resolve via glibc getaddrinfo (cgo resolver) so it
# honors the nss_wrapper (LD_PRELOAD) ingress-host mapping that add-host.sh writes.
# Go's native resolver ignores LD_PRELOAD, resolving *.example.com via the resolv.conf
# wildcard to a wrong platform IP -> EOF. Needs the CGO_ENABLED=1 build above.
ENV GODEBUG=netdns=cgo
ENV TEST_COMMAND="/app/bin/sonarqube-e2e.test"
ENTRYPOINT ["/app/testing/sonarqube-e2e.test"]
