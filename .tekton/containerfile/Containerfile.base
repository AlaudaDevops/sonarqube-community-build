# migration(sonarqube) P1/P2: hub-mirrors.alauda.cn (internal Docker Hub mirror,
# unreachable from edge-build) -> docker.io/library (literal, pulled direct). Same
# host+tag proven on the 2025 migration branch's test-base build.
FROM registry-cache.alauda.io/library/openjdk:26-ea-17-jdk-slim-bookworm

WORKDIR /app

ARG SONAR_SCANNER_VERSION=7.1.0.4889
# sonar-scanner-cli ships a bundled JRE for each arch it publishes; pick the
# variant matching the build arch so the resulting image works on both amd64
# and arm64 nodes. The previous hard-coded `-linux-x64` variant crashed with
# `exec: /app/sonar-scanner/jre/bin/java: Exec format error` on Kylin arm64
# release-test runs (env1). SonarSource publishes -linux-x64 and -linux-aarch64
# under the same URL prefix.
RUN set -ex; \
    apt-get update; \
    apt-get install -y nodejs unzip maven curl ca-certificates tzdata bash locales make wget git jq; \
    case "$(arch)" in \
      aarch64|arm64) SCANNER_ARCH_SUFFIX=linux-aarch64 ;; \
      *)             SCANNER_ARCH_SUFFIX=linux-x64 ;; \
    esac; \
    curl -O https://binaries.sonarsource.com/Distribution/sonar-scanner-cli/sonar-scanner-cli-${SONAR_SCANNER_VERSION}-${SCANNER_ARCH_SUFFIX}.zip; \
    unzip sonar-scanner-cli-${SONAR_SCANNER_VERSION}-${SCANNER_ARCH_SUFFIX}.zip; \
    mv sonar-scanner-${SONAR_SCANNER_VERSION}-${SCANNER_ARCH_SUFFIX} sonar-scanner; \
    rm sonar-scanner-cli-${SONAR_SCANNER_VERSION}-${SCANNER_ARCH_SUFFIX}.zip; \
    /app/sonar-scanner/bin/sonar-scanner --version; \
    rm -rf /var/lib/apt/lists/*

ARG YQ_VERSION=4.25.2
ARG KUBECTL_VERSION=1.28.2
ARG HELM_VERSION=3.12.3

RUN set -eux; \
    if [ "$(arch)" = "arm64" ] || [ "$(arch)" = "aarch64" ]; then \
    export ARCH="arm64"; \
    export ARCH_ALIAS="arm64"; \
    else \
    export ARCH="amd64"; \
    export ARCH_ALIAS="x86_64"; \
    fi; \
    mkdir -p tmp; \
    mkdir -p bin; \
    curl -sfL https://github.com/mikefarah/yq/releases/download/v${YQ_VERSION}/yq_linux_${ARCH} -o ./bin/yq && \
    curl -sfL https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/${ARCH}/kubectl -o ./bin/kubectl && \
    curl -sfL https://get.helm.sh/helm-v${HELM_VERSION}-linux-${ARCH}.tar.gz | tar xzf - -C tmp 2>&1 && mv tmp/linux-${ARCH}/helm ./bin && \
    chmod +x ./bin/* && \
    rm -rf tmp && \
    ./bin/yq --version && \
    ./bin/kubectl version --client && \
    ./bin/helm version && \
    jq --version
